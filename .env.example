# Copy to .env for local runs (uvicorn app.main:app --reload). Never commit .env.

# --- service --------------------------------------------------------------
APP_NAME=contentops-agent
APP_VERSION=0.1.0
ENVIRONMENT=local
LOG_LEVEL=INFO
LOG_FORMAT=json
METRICS_ENABLED=true

# --- persistence ----------------------------------------------------------
DATABASE_PATH=data/contentops.db
MAX_REPORTS_RETURNED=100

# --- variant generator integration ---------------------------------------
# mock = deterministic local variants, http = call the real service
VARIANT_GENERATOR_MODE=mock
VARIANT_GENERATOR_BASE_URL=http://localhost:8000
VARIANT_GENERATOR_TIMEOUT_SECONDS=5
VARIANT_GENERATOR_MAX_RETRIES=2
# clean | overflow | missing_field | duplicate | generator_error
MOCK_VARIANT_SCENARIO=clean

# --- social media studio integration -------------------------------------
STUDIO_MODE=mock
STUDIO_BASE_URL=http://localhost:3000
STUDIO_TIMEOUT_SECONDS=5
STUDIO_MAX_RETRIES=2

# --- optional semantic LLM ------------------------------------------------
# Leave disabled to run entirely offline with deterministic checks.
LLM_ENABLED=false
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=20

# --- thresholds -----------------------------------------------------------
SEMANTIC_THRESHOLD=0.35
DUPLICATE_THRESHOLD=0.90
